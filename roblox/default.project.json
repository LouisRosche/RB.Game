{
  "name": "AlchemyAcademy",
  "tree": {
    "$className": "DataModel",
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "Client": {
          "$path": "src/client"
        }
      }
    },
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerStorage": {
      "$className": "ServerStorage",
      "Vendor": {
        "$className": "Folder",
        "$comment": "Place third-party server modules here. ProfileService.luau required — see DataService.luau for download instructions.",
        "$path": "src/server/Vendor"
      }
    }
  }
}
